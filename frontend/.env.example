# ==================================================
# FRONTEND CONFIGURATION (Vite)
# ==================================================

# Vite Dev Server Port (local dev only)
VITE_PORT=5173

# Application Title
VITE_APP_TITLE=Qoneqt AI Video Studio

# ---------------------------------------------------
# IMPORTANT FOR VERCEL DEPLOYMENT
# ---------------------------------------------------
# Set this to your deployed backend Vercel URL.
# Example: https://your-backend-project.vercel.app
# Do NOT add a trailing slash.
VITE_BACKEND_URL=http://localhost:5000

# Full API base URL used by the axios client.
# LOCAL dev: leave as /api (proxy handles it)
# VERCEL production: set to https://your-backend.vercel.app/api
VITE_API_BASE_URL=/api
