# ==================================================
# ROOT ENVIRONMENT TEMPLATE (DOCKER / FULL-STACK)
# ==================================================

# ==================================================
# BACKEND SERVER CONFIGURATION
# ==================================================
PORT=5000
BACKEND_URL=http://localhost:5000

# ==================================================
# FRONTEND CONFIGURATION (Vite)
# ==================================================
VITE_PORT=5173
VITE_APP_TITLE=Qoneqt AI Video Studio
VITE_BACKEND_URL=http://localhost:5000
VITE_API_BASE_URL=/api

# ==================================================
# AI ENGINE (PRIMARY & FALLBACK)
# ==================================================
# Google Gemini API (Primary LLM for structured scripting & multimodal analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (Fallback LLM for lightning-fast Llama 3.3 70B inference)
GROQ_API_KEY=your_groq_api_key_here

# ==================================================
# STOCK MEDIA PROVIDERS
# ==================================================
# Pexels API (Primary 9:16 vertical stock video & photo search)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API (Fallback stock footage provider)
PIXABAY_API_KEY=your_pixabay_api_key_here

# ==================================================
# VOICE SYNTHESIS / TEXT-TO-SPEECH
# ==================================================
# ElevenLabs API (High-fidelity voice narration)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ==================================================
# CLOUD STORAGE
# ==================================================
# Cloudinary (CDN video hosting, transformations, and thumbnails)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================================================
# DATABASE
# ==================================================
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# ==================================================
# QONEQT PLATFORM INTEGRATION
# ==================================================
# Qoneqt Global Feed Publishing Credentials
QONEQT_API_KEY=your_qoneqt_api_key
QONEQT_API_URL=https://api.qoneqt.com/v1
