{
  "version": 2,
  "name": "qoneqt-ai-video-studio-backend",
  "installCommand": "npm install",
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "includeFiles": "src/**,public/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
