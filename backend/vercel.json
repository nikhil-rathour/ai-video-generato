{
  "version": 2,
  "name": "qoneqt-ai-video-studio-backend",
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@ffmpeg-installer/**,node_modules/@ffprobe-installer/**,src/**,public/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
