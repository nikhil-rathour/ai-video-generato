# ==================================================
# BACKEND SERVER CONFIGURATION
# ==================================================
PORT=5000
BACKEND_URL=http://localhost:5000

# ==================================================
# AI MODELS (PRIMARY & FALLBACK)
# ==================================================
# Google Gemini API Key (Primary LLM for script generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fallback LLM for Llama inference)
GROQ_API_KEY=your_groq_api_key_here

# ==================================================
# MEDIA PROVIDERS (STOCK FOOTAGE & IMAGES)
# ==================================================
# Pexels API Key (Primary vertical video search)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API Key (Secondary fallback stock media)
PIXABAY_API_KEY=your_pixabay_api_key_here

# ==================================================
# VOICE & TTS (TEXT-TO-SPEECH)
# ==================================================
# ElevenLabs API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ElevenLabs Voice ID (Default: Rachel / 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ==================================================
# CLOUD STORAGE & CDN
# ==================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================================================
# DATABASE
# ==================================================
# MongoDB Atlas or Local MongoDB URI
MONGODB_URI=mongodb://localhost:27017/HP

# ==================================================
# QONEQT PLATFORM INTEGRATION
# ==================================================
QONEQT_API_KEY=your_qoneqt_api_key_here
QONEQT_API_URL=https://api.qoneqt.com/v1
