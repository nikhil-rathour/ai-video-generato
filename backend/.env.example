# ==================================================
# BACKEND SERVER CONFIGURATION
# ==================================================
PORT=5000

# ---------------------------------------------------
# IMPORTANT FOR VERCEL DEPLOYMENT
# ---------------------------------------------------
# Set BACKEND_URL to your deployed backend Vercel URL so that
# local-storage fallback URLs are correct. Example:
#   BACKEND_URL=https://your-backend.vercel.app
# Set FRONTEND_URL to your frontend Vercel URL for correct CORS. Example:
#   FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ==================================================
# AI MODELS (PRIMARY & FALLBACK)
# ==================================================
# Google Gemini API Key (Primary LLM for script generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fallback LLM for Llama inference)
GROQ_API_KEY=your_groq_api_key_here

# ==================================================
# MEDIA PROVIDERS (STOCK FOOTAGE & IMAGES)
# ==================================================
# Pexels API Key (Primary vertical video search)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API Key (Secondary fallback stock media)
PIXABAY_API_KEY=your_pixabay_api_key_here

# ==================================================
# VOICE & TTS (TEXT-TO-SPEECH)
# ==================================================
# ElevenLabs API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ElevenLabs Voice ID (Default: Rachel / 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ==================================================
# CLOUD STORAGE & CDN
# ==================================================
# NOTE: Cloudinary is REQUIRED on Vercel since there is no persistent disk.
# Without Cloudinary, generated videos will be lost after each request.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================================================
# DATABASE
# ==================================================
# MongoDB Atlas URI (required for persistent storage)
# Local MongoDB does NOT work on Vercel - use MongoDB Atlas.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/qoneqt?retryWrites=true&w=majority

# ==================================================
# QONEQT PLATFORM INTEGRATION
# ==================================================
QONEQT_API_KEY=your_qoneqt_api_key_here
QONEQT_API_URL=https://api.qoneqt.com/v1
